{
  "name": "proxy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/proxy/files",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/deploy/build.sh proxy validate"
      },
      "inputs": ["default", "{workspaceRoot}/tools/deploy/build.sh"]
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/deploy/build.sh proxy"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'deploy not configured: replace this target with your deploy mechanism (see tools/deploy/README.md)' >&2; exit 1"
      }
    },
    "validate": {
      "executor": "nx:noop",
      "dependsOn": ["build"]
    }
  }
}
