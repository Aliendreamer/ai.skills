{
  // Markdown lint config for THIS repo's authored docs. Run: pnpm lint:md (add :fix to auto-correct).
  // Mirrors the DnD ruleset. Vendored caches, build outputs, and generated specs are ignored.
  // `.claude/**` is deliberately NOT ignored: those 41 skill/command docs are first-party, tracked, and
  // hand-edited, so they get the same gate as the rest. `openspec/**` stays out — it is generated and is
  // governed by `openspec validate --strict` instead (its `##`-first, no-H1 shape would fail MD041 anyway).
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    "**/node_modules/**",
    "**/dist/**",
    "**/.nx/**",
    "**/bin/**",
    "**/obj/**",
    ".git",
    ".github/**",
    ".superpowers/**",
    ".serena/**",
    "openspec/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD036": false,
    "MD040": false,
    "MD026": false,
    "MD060": false
  }
}
